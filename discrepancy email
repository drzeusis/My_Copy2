Private Sub cmdSendDiscrepancyEmail_Click()
    Dim ids() As Long
    Dim count As Long
    GetSelectedIDs ids, count
    If count = 0 Then
        MsgBox "Please select at least one shipment.", vbExclamation
        Exit Sub
    End If
    SendDiscrepancyEmails ids, count
End Sub

