VBA:

vb
Option Compare Database
Option Explicit

Private currentStudyID As Long
Private isAddingNew    As Boolean

Private Sub Form_Load()
    isAddingNew = False
    If Not IsNull(Me.OpenArgs) And Me.OpenArgs <> "" Then
        LoadForStudy CLng(Me.OpenArgs)
    End If
End Sub

Public Sub LoadForStudy(studyID As Long)
    currentStudyID = studyID
    Me.lblStudyTitle.Caption = "Discrepancies — Study " & _
        Nz(DLookup("StudyNumber", "tblStudies", "StudyID=" & studyID), "")

    Me.subDiscrepancySummaryList.Form.RecordSource = _
        "SELECT d.DiscrepancyID, sh.SR & ' | ' & Nz(d.DiscrepancyType,'') AS DisplayText, d.Resolved " & _
        "FROM tblDiscrepancies d INNER JOIN tblShipments sh ON d.ShipmentID = sh.ShipmentID " & _
        "WHERE sh.StudyID = " & studyID & " ORDER BY sh.SR, d.DateReported DESC"
    Me.subDiscrepancySummaryList.Form.Requery

    ClearDetailPanel
End Sub

Public Sub DiscrepancySelected(discrepancyID As Long)
    isAddingNew = False
    If discrepancyID = 0 Then
        ClearDetailPanel
        Exit Sub
    End If
    Me.RecordSource = "SELECT * FROM tblDiscrepancies WHERE DiscrepancyID=" & discrepancyID
    SetDetailEnabled True
    Me.cboSR.Enabled = False
End Sub

Private Sub ClearDetailPanel()
    Me.RecordSource = ""
    SetDetailEnabled False
End Sub

Private Sub SetDetailEnabled(state As Boolean)
    Me.cboSR.Enabled              = state
    Me.cboDiscrepancyType.Enabled = state
    Me.txtSamplesNumber.Enabled   = state
    Me.txtDescription.Enabled     = state
    Me.chkResolved.Enabled        = state
    Me.txtResolution.Enabled      = state
    Me.cmdSave.Enabled            = state
End Sub

Private Sub cmdNew_Click()
    If currentStudyID = 0 Then Exit Sub
    isAddingNew = True
    Me.RecordSource = "tblDiscrepancies"
    Me.AllowAdditions = True
    DoCmd.GoToRecord , , acNewRec

    Me.cboSR.RowSource = "SELECT ShipmentID, SR FROM tblShipments WHERE StudyID=" & currentStudyID & " ORDER BY SR"
    Me.cboSR.Enabled = True
    SetDetailEnabled True
    Me!DateReported = Now()
    Me!ReportedBy = gCurrentUser
    Me!Resolved = False
End Sub

Private Sub cmdSave_Click()
    If IsNull(Me!ShipmentID) Then
        MsgBox "Please select a shipment (SR).", vbExclamation
        Exit Sub
    End If
    If Trim(Nz(Me!DiscrepancyType, "")) = "" Then
        MsgBox "Please select a discrepancy type.", vbExclamation
        Exit Sub
    End If

    Dim shipmentID As Long
    shipmentID = Me!ShipmentID

    If Me!Resolved = True And IsNull(Me!ResolvedDate) Then
        Me!ResolvedBy = gCurrentUser
        Me!ResolvedDate = Now()
    End If

    If Me.Dirty Then Me.Dirty = False

    WriteLog IIf(isAddingNew, "Add Discrepancy", "Edit Discrepancy"), "frmDiscrepancies", "ShipmentID: " & shipmentID
    UpdateShipmentStatusFromDiscrepancies shipmentID

    isAddingNew = False
    LoadForStudy currentStudyID
End Sub

Private Sub cmdClose_Click()
    DoCmd.Close acForm, Me.Name
End Sub

Private Sub cboDiscrepancyType_NotInList(NewData As String, Response As Integer)
    MsgBox "'" & NewData & "' is not a valid type. Please choose from the list.", vbExclamation
    Response = acDataErrContinue
End Sub

