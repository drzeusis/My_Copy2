Private Sub cmdAddDiscrepancy_Click()
    Dim ids() As Long
    Dim count As Long
    GetSelectedIDs ids, count
    If count = 0 Then
        MsgBox "Please select a shipment.", vbExclamation
        Exit Sub
    End If
    If count > 1 Then
        MsgBox "Please select only one shipment to add a discrepancy.", vbExclamation
        Exit Sub
    End If

    Dim shipmentID As Long
    shipmentID = ids(0)

    Dim studyNumber As String
    Dim sr As String
    studyNumber = Nz(DLookup("StudyNumber", "tblStudies", _
                  "StudyID=(SELECT StudyID FROM tblShipments WHERE ShipmentID=" & shipmentID & ")"), "")
    sr = Nz(DLookup("SR", "tblShipments", "ShipmentID=" & shipmentID), "")

    If MsgBox("Do you want to add a discrepancy to '" & studyNumber & "' SR# '" & sr & "'?", _
              vbYesNo + vbQuestion, "Add Discrepancy") = vbNo Then Exit Sub

    Dim db As DAO.Database
    Set db = CurrentDb()
    db.Execute "INSERT INTO tblDiscrepancies (ShipmentID, DateReported, Resolved) VALUES (" & _
               shipmentID & ", #" & Format(Date, "mm/dd/yyyy") & "#, False)", dbFailOnError

    WriteLog "Add Discrepancy", "fsubExternalShipments", "ShipmentID: " & shipmentID
    UpdateShipmentStatusFromDiscrepancies shipmentID
    RefreshTable3
End Sub
