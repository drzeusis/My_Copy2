Private Sub cmdDeleteDiscrepancy_Click()
    If selectedDiscrepancyID = 0 Then
        MsgBox "Please click on a discrepancy inside an expanded shipment row first.", vbExclamation
        Exit Sub
    End If

    If MsgBox("Delete this discrepancy? This cannot be undone.", vbYesNo + vbQuestion, "Confirm Delete") = vbNo Then Exit Sub

    Dim shipmentID As Long
    shipmentID = selectedDiscrepancyShipmentID

    CurrentDb.Execute "DELETE FROM tblDiscrepancies WHERE DiscrepancyID=" & selectedDiscrepancyID, dbFailOnError
    WriteLog "Delete Discrepancy", "fsubExternalShipments", "DiscrepancyID: " & selectedDiscrepancyID

    selectedDiscrepancyID = 0
    selectedDiscrepancyShipmentID = 0

    UpdateShipmentStatusFromDiscrepancies shipmentID
    RefreshTable3
End Sub

