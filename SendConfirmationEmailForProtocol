Public Sub SendConfirmationEmailForProtocol(selectedIDs() As Long, count As Long, isCorrection As Boolean)
    On Error GoTo errHandler

    Dim db            As DAO.Database
    Dim rs            As DAO.Recordset
    Set db = CurrentDb()

    Dim firstProtocol  As String
    Dim monitorName    As String
    Dim monitorEmail   As String
    Dim directorEmail  As String
    Dim firstDirector  As String
    Dim ccField        As String
    Dim sciEmails      As String
    Dim tableRows      As String
    Dim srList         As String
    Dim studyNumbers() As String
    Dim studyNumberCount As Long
    Dim i              As Long

    studyNumberCount = 0
    ReDim studyNumbers(0)

    For i = 0 To count - 1
        Dim strSQL As String
        strSQL = "SELECT sh.ShipmentID, sh.DeliveryDate, sh.SR, sh.Samples, sh.Samples, sh.Waybill, sh.Condition, " & _
                 "st.StudyNumber, st.SponsorProtocol, st.Matrix, st.StorageTemp, " & _
                 "st.MonitorName, st.MonitorEmail, " & _
                 "st.StudyDirector, st.StudyDirectorEmail, " & _
                 "st.Scientist, st.ScientistEmail, st.CC " & _
                 "FROM tblShipments sh " & _
                 "INNER JOIN tblStudies st ON sh.StudyID = st.StudyID " & _
                 "WHERE sh.ShipmentID = " & selectedIDs(i)
        Set rs = db.OpenRecordset(strSQL)

        If rs.EOF Then
            MsgBox "Could not find data for shipment " & (i + 1) & ".", vbExclamation
            rs.Close: Exit Sub
        End If

        If Trim(Nz(rs!SR, "")) = "" Then
            MsgBox "SR is missing for shipment " & (i + 1) & ".", vbExclamation
            rs.Close: Exit Sub
        End If
        If Trim(Nz(rs!StudyNumber, "")) = "" Then
            MsgBox "Study Number is missing for shipment " & (i + 1) & ".", vbExclamation
            rs.Close: Exit Sub
        End If
        If Trim(Nz(rs!Matrix, "")) = "" Then
            MsgBox "Matrix is missing for shipment " & (i + 1) & ".", vbExclamation
            rs.Close: Exit Sub
        End If
        If IsNull(rs!Samples) Or Not IsNumeric(rs!Samples) Then
            MsgBox "Number of Samples is missing for shipment " & (i + 1) & ".", vbExclamation
            rs.Close: Exit Sub
        End If
        If Trim(Nz(rs!Waybill, "")) = "" Then
            MsgBox "Waybill is missing for shipment " & (i + 1) & ".", vbExclamation
            rs.Close: Exit Sub
        End If
        If IsNull(rs!DeliveryDate) Or Not IsDate(rs!DeliveryDate) Then
            MsgBox "Date is missing for shipment " & (i + 1) & ".", vbExclamation
            rs.Close: Exit Sub
        End If
        If Trim(Nz(rs!MonitorEmail, "")) = "" Then
            MsgBox "Monitor Email is missing for shipment " & (i + 1) & ".", vbExclamation
            rs.Close: Exit Sub
        End If
        If Trim(Nz(rs!ScientistEmail, "")) = "" Then
            MsgBox "Scientist Email is missing for shipment " & (i + 1) & ".", vbExclamation
            rs.Close: Exit Sub
        End If
        If Trim(Nz(rs!StudyDirectorEmail, "")) = "" Then
            MsgBox "Study Director Email is missing for shipment " & (i + 1) & ".", vbExclamation
            rs.Close: Exit Sub
        End If
        If Trim(Nz(rs!Condition, "")) = "" Then
            MsgBox "Condition is missing for shipment " & (i + 1) & ".", vbExclamation
            rs.Close: Exit Sub
        End If

        If i = 0 Then
            firstProtocol = Nz(rs!SponsorProtocol, "")
            monitorName   = Nz(rs!MonitorName, "")
            monitorEmail  = Nz(rs!MonitorEmail, "")
            firstDirector = Nz(rs!StudyDirectorEmail, "")
            directorEmail = Nz(rs!StudyDirectorEmail, "")
            ccField       = Nz(rs!CC, "")
            sciEmails     = Nz(rs!ScientistEmail, "")
        Else
            If Nz(rs!StudyDirectorEmail, "") <> firstDirector Then
                If MsgBox("Study Director is different across the selection." & vbCrLf & _
                          "Do you want to continue?", _
                          vbYesNo + vbExclamation, "Different Study Director") = vbNo Then
                    rs.Close: Exit Sub
                End If
            End If
            Dim sciEmail As String
            sciEmail = Nz(rs!ScientistEmail, "")
            If sciEmail <> "" And InStr(1, sciEmails, sciEmail, vbTextCompare) = 0 Then
                If sciEmails <> "" Then sciEmails = sciEmails & ";"
                sciEmails = sciEmails & sciEmail
            End If
            Dim newCC As String
            newCC = Nz(rs!CC, "")
            If newCC <> "" And InStr(1, ccField, newCC, vbTextCompare) = 0 Then
                If ccField <> "" Then ccField = ccField & ";"
                ccField = ccField & newCC
            End If
        End If

        '-- Track SR list for the filename
        If srList <> "" Then srList = srList & ","
        srList = srList & Nz(rs!SR, "")

        '-- Track distinct StudyNumbers (handles the mismatched-study edge case)
        Dim thisStudyNumber As String
        thisStudyNumber = Nz(rs!StudyNumber, "")
        Dim foundSN As Boolean
        foundSN = False
        Dim sn As Long
        For sn = 0 To studyNumberCount - 1
            If studyNumbers(sn) = thisStudyNumber Then foundSN = True: Exit For
        Next sn
        If Not foundSN Then
            ReDim Preserve studyNumbers(studyNumberCount)
            studyNumbers(studyNumberCount) = thisStudyNumber
            studyNumberCount = studyNumberCount + 1
        End If

        tableRows = tableRows & "<tr>" & _
            "<td>" & Format(rs!DeliveryDate, "dd-mmm-yyyy") & "</td>" & _
            "<td>" & Nz(rs!SR, "")          & "</td>" & _
            "<td>" & Nz(rs!StudyNumber, "") & "</td>" & _
            "<td>" & Nz(rs!Matrix, "")      & "</td>" & _
            "<td>" & Nz(rs!StorageTemp, "") & "</td>" & _
            "<td>" & Nz(rs!Samples, "")     & "</td>" & _
            "<td>" & Nz(rs!Waybill, "")     & "</td>" & _
            "<td>" & Nz(rs!Condition, "")   & "</td>" & _
            "</tr>"
        rs.Close
    Next i

    Dim firstName As String
    If InStr(monitorName, ",") > 0 Then
        firstName = Trim(Mid(monitorName, InStr(monitorName, ",") + 1))
    Else
        firstName = monitorName
    End If

    Dim finalCC As String
    finalCC = directorEmail
    If sciEmails <> "" Then
        Dim parts() As String
        Dim j       As Long
        parts = Split(sciEmails, ";")
        For j = 0 To UBound(parts)
            Dim addr As String
            addr = Trim(parts(j))
            If addr <> "" And LCase(addr) <> LCase(Trim(directorEmail)) Then
                If finalCC <> "" Then finalCC = finalCC & ";"
                finalCC = finalCC & addr
            End If
        Next j
    End If
    If ccField <> "" Then
        If finalCC <> "" Then finalCC = finalCC & ";"
        finalCC = finalCC & ccField
    End If

    Dim html As String
    html = "<html><body style='font-family:Calibri;font-size:12pt;'>"

    If isCorrection Then
        html = html & "<p style='color:red;font-weight:bold;'>" & _
                      "This is a correction email, please disregard the previous email for this shipment." & _
                      "</p>"
    End If

    html = html & "<p>Hi " & firstName & ",</p>"
    html = html & "<p>This email is to inform you that the following samples for study <b>" & _
                  firstProtocol & "</b> were received at CRL Montreal.</p>"
    html = html & "<table border='1' cellpadding='5' cellspacing='0' " & _
                  "style='border-collapse:collapse;font-size:12pt;'>"
    html = html & "<tr style='background:#f2f2f2;font-weight:bold;'>"
    html = html & "<td>Date</td><td>SR</td><td>Study Number</td>" & _
                  "<td>Matrix</td><td>Storage Temp</td><td>Number of Samples</td><td>Waybill</td><td>Condition</td></tr>"
    html = html & tableRows
    html = html & "</table>"
    html = html & "<p>Once the samples are verified, you might be contacted by us or " & _
                  "the scientist in charge of the study to clarify discrepancies or " & _
                  "address issues, if any.</p>"
    html = html & "<p>If any pertinent information regarding samples were not included " & _
                  "on sample manifest (e.g. samples thawed prior to shipment, deviation " & _
                  "during collection, etc.) please inform CRL MTL in a timely manner to " & _
                  "allow adequate stability assessment by the scientist.</p>"
    html = html & "</body></html>"

    Dim olApp  As Object
    Dim olMail As Object
    Set olApp  = CreateObject("Outlook.Application")
    Set olMail = olApp.CreateItem(0)
    With olMail
        .To      = monitorEmail
        .CC      = finalCC
        .Subject = IIf(isCorrection, "[CORRECTION] ", "") & _
                   "Confirmation of Samples Received Protocol# " & firstProtocol
        .Display
        .htmlBody = html & .htmlBody
    End With

    SaveEmailToStudyFolder olMail, studyNumbers, studyNumberCount, firstProtocol, srList, isCorrection

    WriteLog "Send Confirmation Email", "frmShipments", _
        "Protocol: " & firstProtocol & " | Correction: " & isCorrection
    Exit Sub

errHandler:
    MsgBox "Error sending email: " & Err.Description, vbCritical
End Sub
