Step 2 — Full VBA (replace the entire module)
vb
Option Compare Database
Option Explicit

Private Const DEFAULT_CC As String = "mtl-watson@crl.com"

Private Sub Form_Load()
    If IsNull(Me.OpenArgs) Or Me.OpenArgs = "" Or Me.OpenArgs = "NEW" Then
        Me.RecordSource = "tblStudies"
        Me.AllowAdditions = True
        DoCmd.GoToRecord , , acNewRec
        Me.txtCC.Value = DEFAULT_CC
        Me.lblTitle.Caption = "Add New Study"
        Me.lblSubtitle.Caption = ""
    Else
        Dim studyID As Long
        studyID = CLng(Me.OpenArgs)
        Me.RecordSource = "SELECT * FROM tblStudies WHERE StudyID=" & studyID
        Me.AllowAdditions = False
        Me.lblTitle.Caption = "Study " & Nz(Me!StudyNumber, "") & " Quick Edit"
        Me.lblSubtitle.Caption = Nz(Me!SponsorProtocol, "")
    End If
End Sub

Private Sub cmdAddClient_Click()
    Dim clientName As String
    clientName = Trim(InputBox("Enter new client name:", "Add Client"))
    If clientName = "" Then Exit Sub
    If DCount("*", "tblClients", "ClientName='" & Replace(clientName, "'", "''") & "'") > 0 Then
        MsgBox "Client '" & clientName & "' already exists.", vbExclamation
        Exit Sub
    End If
    Dim db As DAO.Database
    Set db = CurrentDb()
    db.Execute "INSERT INTO tblClients (ClientName) VALUES ('" & Replace(clientName, "'", "''") & "')", dbFailOnError
    Dim newID As Long
    newID = db.OpenRecordset("SELECT MAX(ClientID) AS ID FROM tblClients")(0)
    Me.cboClientID.Requery
    Me.cboClientID.Value = newID
    WriteLog "Add Client", "frmEditStudyQuick", "Client: " & clientName
End Sub

Private Sub cmdSave_Click()
    If Not ValidateForm() Then Exit Sub
    Dim wasNew As Boolean
    wasNew = Me.NewRecord
    If Me.Dirty Then Me.Dirty = False
    WriteLog IIf(wasNew, "Add Study", "Edit Study"), "frmEditStudyQuick", "StudyID: " & Nz(Me!StudyID, 0)
    DoCmd.Close acForm, Me.Name
End Sub

Private Sub cmdCancel_Click()
    If Me.Dirty Then Me.Undo
    DoCmd.Close acForm, Me.Name
End Sub

Private Function ValidateForm() As Boolean
    ValidateForm = False
    If Trim(Nz(Me!SponsorProtocol, "")) = "" Then
        MsgBox "Sponsor Protocol is required.", vbExclamation: Exit Function
    End If
    If Trim(Nz(Me!ClientProtocol, "")) = "" Then
        MsgBox "Client Protocol is required.", vbExclamation: Exit Function
    End If
    If Trim(Nz(Me!StudyNumber, "")) = "" Then
        MsgBox "Study Number is required.", vbExclamation: Exit Function
    End If
    If Trim(Nz(Me!Matrix, "")) = "" Then
        MsgBox "Matrix is required.", vbExclamation: Exit Function
    End If
    If Trim(Nz(Me!StorageTemp, "")) = "" Then
        MsgBox "Storage Temp is required.", vbExclamation: Exit Function
    End If
    If IsNull(Me!Tech1ID) Then
        MsgBox "Tech 1 is required.", vbExclamation: Exit Function
    End If
    If IsNull(Me!Tech2ID) Then
        MsgBox "Tech 2 is required.", vbExclamation: Exit Function
    End If
    ValidateForm = True
End Function

Private Sub cboStorageTemp_NotInList(NewData As String, Response As Integer)
    MsgBox "'" & NewData & "' is not a valid option. Please choose from the list.", vbExclamation
    Response = acDataErrContinue
End Sub
