Private Sub Form_Load()
    ' ... your existing Form_Load code stays above this ...
    PopulateBackupMonthsList
    LoadBackupSettingsFields
End Sub

Private Sub PopulateBackupMonthsList()
    Dim rowSrc As String
    Dim i As Long
    Dim d As Date
    For i = 0 To 23
        d = DateAdd("m", -i, Date)
        Dim monthKey As Long
        monthKey = Year(d) * 100 + Month(d)
        If rowSrc <> "" Then rowSrc = rowSrc & ";"
        rowSrc = rowSrc & monthKey & ";" & Format(d, "mmmm yyyy")
    Next i
    Me.lstBackupMonths.ColumnCount = 2
    Me.lstBackupMonths.ColumnWidths = "0cm;4cm"
    Me.lstBackupMonths.RowSourceType = "Value List"
    Me.lstBackupMonths.RowSource = rowSrc
End Sub

Private Sub LoadBackupSettingsFields()
    Me.txtShipmentsPath.Value = GetBackupSetting("ShipmentsPath")
    Me.txtShipmentsUpdatePath.Value = GetBackupSetting("ShipmentsUpdatePath")
    Me.txtBackendBackupPath.Value = GetBackupSetting("BackendBackupPath")
End Sub

Private Sub cmdBrowseShipmentsPath_Click()
    Dim fd As Object
    Set fd = Application.FileDialog(4) ' msoFileDialogFolderPicker
    If fd.Show = -1 Then Me.txtShipmentsPath.Value = fd.SelectedItems(1)
End Sub

Private Sub cmdBrowseShipmentsUpdatePath_Click()
    Dim fd As Object
    Set fd = Application.FileDialog(4)
    If fd.Show = -1 Then Me.txtShipmentsUpdatePath.Value = fd.SelectedItems(1)
End Sub

Private Sub cmdBrowseBackendBackupPath_Click()
    Dim fd As Object
    Set fd = Application.FileDialog(4)
    If fd.Show = -1 Then Me.txtBackendBackupPath.Value = fd.SelectedItems(1)
End Sub

Private Sub cmdSaveBackupSettings_Click()
    SaveBackupSettings Me.txtShipmentsPath.Value, Me.txtShipmentsUpdatePath.Value, Me.txtBackendBackupPath.Value
    WriteLog "Save Backup Settings", "frmSettings", ""
    MsgBox "Backup settings saved.", vbInformation
End Sub

Private Sub cmdManualBackup_Click()
    Dim monthKeys() As Long
    Dim monthCount As Long
    monthCount = 0
    ReDim monthKeys(0)

    Dim i As Long
    For i = 0 To Me.lstBackupMonths.ListCount - 1
        If Me.lstBackupMonths.Selected(i) Then
            ReDim Preserve monthKeys(monthCount)
            monthKeys(monthCount) = CLng(Me.lstBackupMonths.ItemData(i))
            monthCount = monthCount + 1
        End If
    Next i

    If monthCount = 0 Then
        MsgBox "Please select at least one month.", vbExclamation
        Exit Sub
    End If

    Dim fd As Object
    Set fd = Application.FileDialog(4)
    If fd.Show <> -1 Then Exit Sub

    Dim savePath As String
    savePath = fd.SelectedItems(1) & "\Shipments_Backup_" & Format(Now(), "yyyy-mm-dd_hhnnss") & ".xlsx"

    GenerateShipmentsExcelForMonths monthKeys, monthCount, savePath

    WriteLog "Manual Backup", "frmSettings", "Months: " & monthCount & " File: " & savePath
    MsgBox "Backup file created: " & savePath, vbInformation
End Sub
